<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <io.github.pengveloper.sentinel.relay.LensView
        android:id="@+id/lens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityLiveRegion="polite"
        android:focusable="true" />

    <!-- The signal path, left to right: PC hub, this phone, the glasses. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/hub_pad"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/hub_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot" />

                <View
                    android:id="@+id/link1a"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                style="@style/Text.NodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/node_hub" />

            <TextView
                android:id="@+id/hub_state"
                style="@style/Text.NodeState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/link1b"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="visible" />

                <View
                    android:id="@+id/phone_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot" />

                <View
                    android:id="@+id/link2a"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                style="@style/Text.NodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/node_phone" />

            <TextView
                android:id="@+id/phone_state"
                style="@style/Text.NodeState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/link2b"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="visible" />

                <View
                    android:id="@+id/glass_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot" />

                <View
                    android:id="@+id/glass_pad"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/rule"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                style="@style/Text.NodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/node_glasses" />

            <TextView
                android:id="@+id/glass_state"
                style="@style/Text.NodeState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/toggle"
        style="@style/Action.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="22dp" />

    <TextView
        android:id="@+id/toggle_hint"
        style="@style/Text.Help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
